# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Dictionary packs: build artifacts, never committed (95MB-682MB inputs,
# ~20MB outputs). Built by tools/pack_builder/, downloaded by the app.
*.sqlite
*.jsonl
*.jsonl.gz
tools/pack_builder/.venv/
tools/pack_builder/downloads/

# Q8: no lyrics in git. The acceptance fixture therefore stores a DERIVED
# token list (see test/fixtures/), never the lyric text itself -- that keeps
# the count gate reproducible without committing copyrighted content.
